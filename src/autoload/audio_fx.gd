extends Node
## Sound-effect and ambience director.
##
## The original web game ships voice clips only, so the SFX in
## `assets/audio/sfx/` are generated by `tools/build_sfx.gd`. This autoload
## owns the pooled players, the footstep rotation, the looping ambience beds
## and the volume policy (the SFX / UI buses are driven by Settings).
##
## Voice lines stay in `voice_bank.gd`; this node never touches the Voice bus.

const SFX_DIR := "res://assets/audio/sfx/"
const AMB_DIR := "res://assets/audio/ambient/"

const SFX_IDS := [
	"ui_click", "ui_hover", "ui_back", "success", "error", "item",
	"step_1", "step_2", "step_3", "step_4", "ball_bounce", "rim", "throw",
	"whistle", "tick", "coin", "cheer", "unlock", "type", "fizz", "tired",
]
const AMB_IDS := ["campus", "interior"]

const SFX_VOICES := 16
const UI_VOICES := 6
const AMB_VOLUME := -16.0

var _streams: Dictionary = {}
var _sfx_pool: Array[AudioStreamPlayer] = []
var _ui_pool: Array[AudioStreamPlayer] = []
var _ambient: AudioStreamPlayer
var _ambient_kind: String = ""
var _sfx_next: int = 0
var _ui_next: int = 0
var _step_index: int = 0
var _rng := RandomNumberGenerator.new()


func _ready() -> void:
	_rng.randomize()
	_load_streams()
	for i in SFX_VOICES:
		var p := AudioStreamPlayer.new()
		p.bus = "SFX"
		add_child(p)
		_sfx_pool.append(p)
	for i in UI_VOICES:
		var p := AudioStreamPlayer.new()
		p.bus = "UI"
		add_child(p)
		_ui_pool.append(p)
	_ambient = AudioStreamPlayer.new()
	_ambient.bus = "SFX"
	add_child(_ambient)
	EventBus.item_gained.connect(_on_item_gained)
	EventBus.energy_depleted.connect(_on_energy_depleted)
	EventBus.foodie_unlocked.connect(_on_foodie_unlocked)


func _load_streams() -> void:
	for id in SFX_IDS:
		var path: String = SFX_DIR + str(id) + ".wav"
		if ResourceLoader.exists(path):
			_streams[str(id)] = load(path)
		else:
			push_warning("Audio: missing " + path)
	for id in AMB_IDS:
		var path: String = AMB_DIR + "ambient_" + str(id) + ".wav"
		if not ResourceLoader.exists(path):
			push_warning("Audio: missing " + path)
			continue
		var stream := load(path) as AudioStreamWAV
		if stream == null:
			continue
		# The WAVs are authored as seamless loops; set the loop points at
		# runtime so the import settings stay untouched.
		stream.loop_mode = AudioStreamWAV.LOOP_FORWARD
		stream.loop_begin = 0
		stream.loop_end = int(stream.get_length() * float(stream.mix_rate))
		_streams["ambient_" + str(id)] = stream


## Plays a one-shot on the SFX bus. `volume_db` is relative to the bus.
func play(id: String, volume_db: float = -8.0, pitch: float = 1.0) -> void:
	var stream: AudioStream = _streams.get(id)
	if stream == null or _sfx_pool.is_empty():
		return
	var p := _sfx_pool[_sfx_next]
	_sfx_next = (_sfx_next + 1) % _sfx_pool.size()
	p.stream = stream
	p.volume_db = volume_db
	p.pitch_scale = clampf(pitch, 0.5, 2.0)
	p.play()


## UI clicks run on their own pool so a burst of gameplay SFX can never steal
## a menu click.
func play_ui(id: String, volume_db: float = -10.0) -> void:
	var stream: AudioStream = _streams.get(id)
	if stream == null or _ui_pool.is_empty():
		return
	var p := _ui_pool[_ui_next]
	_ui_next = (_ui_next + 1) % _ui_pool.size()
	p.stream = stream
	p.volume_db = volume_db
	p.pitch_scale = 1.0
	p.play()


## Four alternating footstep samples, slightly detuned per step.
func footstep(running: bool) -> void:
	_step_index = (_step_index + 1) % 4
	play("step_%d" % (_step_index + 1), -10.0 if running else -14.0,
		_rng.randf_range(0.92, 1.08))


## Switches the looping ambience bed ("campus", "interior" or "").
func set_ambience(kind: String) -> void:
	if kind == _ambient_kind:
		return
	_ambient_kind = kind
	_ambient.stop()
	if kind == "":
		return
	var stream: AudioStream = _streams.get("ambient_" + kind)
	if stream == null:
		return
	_ambient.stream = stream
	_ambient.volume_db = -40.0
	_ambient.play()
	create_tween().tween_property(_ambient, "volume_db", AMB_VOLUME, 0.8)


func stop_ambience() -> void:
	set_ambience("")


func stream_count() -> int:
	return _streams.size()


func has_stream(id: String) -> bool:
	return _streams.has(id)


func _on_item_gained(_item_id: String) -> void:
	play("item", -8.0)


func _on_energy_depleted() -> void:
	play("tired", -9.0)


func _on_foodie_unlocked() -> void:
	play("unlock", -6.0)
